/ data-turbo=false: calendars/create.turbo_stream only targets the inline panel on the championship form.
= simple_form_for [current_section, @calendar], html: { data: { turbo: false } } do |f|
  = f.error_notification
  div class="form-inputs"
    = f.input :name
    = f.association :season, collection: Season.all
  div class="form-actions mt-4"
    = f.button :submit
