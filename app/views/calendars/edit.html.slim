div class="sm:flex sm:items-center"
  div class="sm:flex-auto"
    h1 class="text-base font-semibold text-gray-900" = @calendar.name
    p class="mt-1 text-sm text-gray-500" = @calendar.season&.name
  div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none"
    = link_to 'Tous les calendriers', section_calendars_path(current_section), class: 'text-sm font-semibold text-indigo-600 hover:text-indigo-500'

div class="mt-8 grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-2"
  section
    h2 class="text-sm font-semibold text-gray-900" Calendrier
    div class="mt-4"
      = render 'form'

  section
    h2 class="text-sm font-semibold text-gray-900" Journées du calendrier
    - days = @calendar.days.order(:period_start_date)
    - if days.empty?
      p class="mt-4 text-sm text-gray-500" Aucune journée dans ce calendrier.
    - else
      div class="mt-4 overflow-x-auto"
        table class="min-w-full divide-y divide-gray-300"
          thead
            tr
              th scope="col" class="py-3.5 pr-3 text-left text-sm font-semibold text-gray-900" Nom
              th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900" 1er jour du weekend
          tbody class="divide-y divide-gray-200"
            = render days

    div class="mt-6" data-controller="dropdown"
      a href="#new-day-collapse" data-action="dropdown#toggle:stop" aria-expanded="false" class="inline-flex items-center gap-x-1 text-sm font-medium text-indigo-600 hover:text-indigo-500"
        svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4"
          path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v5.5h5.5a.75.75 0 010 1.5h-5.5v5.5a.75.75 0 01-1.5 0v-5.5h-5.5a.75.75 0 010-1.5h5.5v-5.5A.75.75 0 0110 3z" clip-rule="evenodd"
        | Rajouter une journée
      div id="new-day-collapse" class="hidden mt-4" data-dropdown-target="menu"
        / data-turbo=false: days/create.turbo_stream only targets the inline panel on the match form.
        = simple_form_for [current_section, @new_day], html: { data: { turbo: false } } do |f|
          = f.error_notification
          = hidden_field_tag :_redirect_url, edit_section_calendar_path(current_section, @calendar)
          div class="form-inputs"
            = f.input :period_start_date
            = f.input :name
            = f.hidden_field :calendar_id
          div class="form-actions mt-4"
            = f.button :submit
