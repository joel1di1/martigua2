- input_class = 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6'
- input_outline = ->(attribute) { @group.errors[attribute].any? ? 'outline-red-300' : 'outline-gray-300' }

div class="grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-3"
  div class="px-4 sm:px-0"
    h2 class="text-base/7 font-semibold text-gray-900" Informations
    p class="mt-1 text-sm/6 text-gray-600" Le nom et la couleur permettent de repérer rapidement le groupe dans les listes et les invitations aux entrainements.

  = form_with model: [current_section, @group], class: 'bg-white shadow-xs outline-1 outline-gray-900/5 sm:rounded-xl md:col-span-2' do |f|
    div class="px-4 py-6 sm:p-8"
      - if @group.errors.any?
        div class="mb-6 rounded-md bg-red-50 p-4"
          h3 class="text-sm font-medium text-red-800"= "Le groupe n'a pas pu être enregistré :"
          ul role="list" class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700"
            - @group.errors.full_messages.each do |message|
              li= message

      div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6"
        div class="sm:col-span-4"
          = f.label :name, 'Nom', class: 'block text-sm/6 font-medium text-gray-900'
          div class="mt-2"
            = f.text_field :name, placeholder: 'Ex : Gardiens, Loisirs…', class: "#{input_class} #{input_outline.call(:name)}"
          - @group.errors[:name].each do |error|
            p class="mt-2 text-sm text-red-600"= error

        div class="sm:col-span-2"
          = f.label :color, 'Couleur', class: 'block text-sm/6 font-medium text-gray-900'
          div class="mt-2"
            = f.color_field :color, class: 'block h-9 w-16 cursor-pointer rounded-md bg-white p-1 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600'

        div class="col-span-full"
          = f.label :description, 'Description', class: 'block text-sm/6 font-medium text-gray-900'
          div class="mt-2"
            = f.text_area :description, rows: 3, class: "#{input_class} #{input_outline.call(:description)}"
          p class="mt-3 text-sm/6 text-gray-600" Quelques mots pour expliquer à qui s'adresse ce groupe.

    div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8"
      = link_to 'Annuler', cancel_path, class: 'text-sm/6 font-semibold text-gray-900'
      = f.submit submit_label, class: 'cursor-pointer rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'
