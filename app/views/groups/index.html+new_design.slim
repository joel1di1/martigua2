- coach = current_user.coach_of?(current_section)
- primary_button = 'inline-flex items-center gap-x-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'

div class="md:flex md:items-center md:justify-between"
  div class="min-w-0 flex-1"
    h1 class="text-2xl/7 font-bold text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight" Groupes
    p class="mt-1 text-sm text-gray-500"
      = "#{pluralize(@groups.size, 'groupe', plural: 'groupes')} pour la saison #{Season.current}"
  - if coach
    div class="mt-4 flex md:mt-0 md:ml-4"
      = link_to new_section_group_path(current_section), class: primary_button do
        = heroicon_mini(:plus, css_class: '-ml-0.5 size-5')
        | Ajouter un groupe

- if @groups.empty?
  div class="mt-8 rounded-xl border-2 border-dashed border-gray-300 px-6 py-12 text-center"
    = heroicon(:rectangle_group, css_class: 'mx-auto size-12 text-gray-400')
    h3 class="mt-2 text-sm font-semibold text-gray-900" Aucun groupe
    p class="mt-1 text-sm text-gray-500" Les groupes permettent d'inviter rapidement plusieurs membres aux entrainements.
- else
  ul role="list" class="mt-8 divide-y divide-gray-100 bg-white shadow-xs outline-1 outline-gray-900/5 sm:rounded-xl"
    - @groups.each do |group|
      = render 'groups/group', group:, coach:
