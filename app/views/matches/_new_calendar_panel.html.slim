div id="new-calendar-panel" data-controller="dropdown"
  a href="#new-calendar-collapse" data-action="dropdown#toggle:stop" aria-expanded="false" class="mt-2 inline-flex items-center gap-x-1 text-xs font-medium text-indigo-600 hover:text-indigo-500"
    svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-3.5"
      path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v5.5h5.5a.75.75 0 010 1.5h-5.5v5.5a.75.75 0 01-1.5 0v-5.5h-5.5a.75.75 0 010-1.5h5.5v-5.5A.75.75 0 0110 3z" clip-rule="evenodd"
    'Ajouter un calendrier
  #new-calendar-collapse.hidden.mt-2 data-dropdown-target="menu"
    - new_calendar = Calendar.new(season: Season.current)
    = simple_form_for [current_section, new_calendar] do |f|
      = f.error_notification
      .form-inputs
        = f.input :name
        = f.hidden_field :season_id
      .form-actions.mt-2
        = f.button :submit, class: 'inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'
