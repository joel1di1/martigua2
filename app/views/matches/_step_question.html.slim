- searchable = local_assigns.fetch(:searchable, false)
.overflow-hidden.rounded-lg.bg-white.shadow-sm.outline-1.-outline-offset-1.outline-gray-900/5
  .px-4.py-6.sm:p-8
    = simple_form_for new_section_match_path(current_section), method: :get do |f|
      = hidden
      label for=field_id class="block text-base font-semibold text-gray-900"
        = title
      .mt-4
        - if searchable
          select id=field_id name=field_name class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:max-w-md sm:text-sm/6" data-controller="ts--select"
            = options_for_select(options)
        - else
          select id=field_id name=field_name class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:max-w-md sm:text-sm/6"
            = options_for_select(options)
      div id="#{field_id}_confirmation" class="mt-2 text-sm font-medium text-green-600 empty:hidden"
      .mt-6.flex.items-center.justify-between
        - if back_path
          = link_to '‹ Précédent', back_path, class: 'text-sm/6 font-semibold text-gray-700 hover:text-gray-900'
        - else
          span
        = f.submit 'Suivant', class: 'inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'
    - if defined?(add_on) && add_on.present?
      .mt-4.border-t.border-gray-900/10.pt-4
        = add_on
