- steps = ['Équipe', 'Compétition', 'Jour', 'Lieu', 'Adversaire', 'Détails']
nav aria-label="Progression" class="mb-8"
  ol role="list" class="flex items-center"
    - steps.each_with_index do |label, index|
      - step_number = index + 1
      li class="relative #{'grow' unless step_number == steps.size}"
        - if step_number < steps.size
          .absolute.inset-0.top-4.flex.items-center aria-hidden="true"
            .h-0.5.w-full class=(step_number < current_step ? 'bg-indigo-600' : 'bg-gray-200')
        .relative.flex.flex-col.items-center.gap-1
          - if step_number < current_step
            span class="flex size-8 items-center justify-center rounded-full bg-indigo-600"
              svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-white"
                path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"
          - elsif step_number == current_step
            span class="flex size-8 items-center justify-center rounded-full border-2 border-indigo-600 bg-white text-sm font-semibold text-indigo-600"
              = step_number
          - else
            span class="flex size-8 items-center justify-center rounded-full border-2 border-gray-300 bg-white text-sm font-semibold text-gray-400"
              = step_number
          span class="hidden text-xs font-medium sm:block #{step_number == current_step ? 'text-indigo-600' : 'text-gray-500'}"
            = label
