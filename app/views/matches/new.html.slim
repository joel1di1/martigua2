- current_step = @wizard_step
.mt-2.md:flex.md:items-center.md:justify-between
  .min-w-0.flex-1
    h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight"
      'Nouveau match
      - if params[:section_team_id].present?
        '-
        = Team.find(params[:section_team_id]).name
      - if params[:championship_id].present?
        '-
        = Championship.find(params[:championship_id]).name

.mt-8.max-w-2xl
  = render 'wizard_steps', current_step: current_step

  - if params[:section_team_id].present? && params[:adversary_team_id].present? && (params[:match].present? && params[:match][:championship_id].present? && params[:match][:day_id].present? && params[:match][:location_id].present? )
    - @match.local_team_id = params[:section_team_id]
    - @match.visitor_team_id = params[:adversary_team_id]
    .overflow-hidden.rounded-lg.bg-white.shadow-sm.outline-1.-outline-offset-1.outline-gray-900/5
      .px-4.py-6.sm:p-8
        = link_to '‹ Précédent', new_section_match_path(current_section, section_team_id: params[:section_team_id], match: { championship_id: params[:match][:championship_id], day_id: params[:match][:day_id], location_id: params[:match][:location_id] }), class: 'mb-4 inline-block text-sm/6 font-semibold text-gray-700 hover:text-gray-900'
        = render 'form'

  - elsif params[:section_team_id].blank?
    = render 'step_question', title: 'Quelle équipe ?', field_id: 'section_team_id', field_name: 'section_team_id', options: current_section.teams.pluck(:name, :id), hidden: nil, back_path: nil, add_on: nil

  - elsif params[:match].blank? || params[:match][:championship_id].blank?
    - hidden = capture do
      = hidden_field_tag :section_team_id, params[:section_team_id]
    - add_on = capture do
      = render 'new_championship_panel', redirect_url: request.original_url
    = render 'step_question', title: 'Quelle compétition ?', field_id: 'match_championship_id', field_name: 'match[championship_id]', options: @section_team.championships.of_current_season.pluck(:name, :id), hidden: hidden, back_path: new_section_match_path(current_section), add_on: add_on

  - elsif params[:match].blank? || params[:match][:day_id].blank?
    - hidden = capture do
      = hidden_field_tag :section_team_id, params[:section_team_id]
      = hidden_field_tag 'match[championship_id]', params[:match][:championship_id]
    - add_on = capture do
      = render 'new_day_panel', calendar: @championship.calendar, redirect_url: request.original_url
    = render 'step_question', title: 'Quel jour ?', field_id: 'match_day_id', field_name: 'match[day_id]', options: @championship.calendar.days.pluck(:name, :id), hidden: hidden, back_path: new_section_match_path(current_section, section_team_id: params[:section_team_id]), add_on: add_on

  - elsif params[:match].blank? || params[:match][:location_id].blank?
    - hidden = capture do
      = hidden_field_tag :section_team_id, params[:section_team_id]
      = hidden_field_tag 'match[championship_id]', params[:match][:championship_id]
      = hidden_field_tag 'match[day_id]', params[:match][:day_id]
    - add_on = capture do
      = render 'new_location_panel', redirect_url: request.original_url
    = render 'step_question', title: 'Quel lieu ?', field_id: 'match_location_id', field_name: 'match[location_id]', options: Location.all.pluck(:name, :id), hidden: hidden, back_path: new_section_match_path(current_section, section_team_id: params[:section_team_id], match: { championship_id: params[:match][:championship_id] }), add_on: add_on

  - elsif params[:adversary_team_id].blank?
    - hidden = capture do
      = hidden_field_tag :section_team_id, params[:section_team_id]
      = hidden_field_tag 'match[championship_id]', params[:match][:championship_id]
      = hidden_field_tag 'match[day_id]', params[:match][:day_id]
      = hidden_field_tag 'match[location_id]', params[:match][:location_id]
    - add_on = capture do
      = render 'new_team_panel', redirect_url: request.original_url, championship_id: params[:championship_id]
    = render 'step_question', title: 'Equipe adverse ?', field_id: 'adversary_team_id', field_name: 'adversary_team_id', options: [[nil, nil]].concat(Team.all.order('name').pluck(:name, :id)), hidden: hidden, back_path: new_section_match_path(current_section, section_team_id: params[:section_team_id], match: { championship_id: params[:match][:championship_id], day_id: params[:match][:day_id] }), add_on: add_on, searchable: true
