- url_objects = [current_section, @user].compact
- can_submit = current_user == @user || current_user.coach_of?(current_section)
- profile_path = current_section ? section_user_path(@user, section_id: current_section.to_param) : user_path(@user)
- contact_emails_url = current_section ? section_user_contact_emails_path(current_section, @user) : user_contact_emails_path(@user)
- trash_icon_path = 'M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0'

div class="mx-auto max-w-4xl pb-16"

  / --- Page heading -------------------------------------------------------------
  div class="md:flex md:items-center md:justify-between md:space-x-5"
    div class="flex items-start space-x-5"
      div class="shrink-0"
        - if @user.avatar.attached?
          = image_tag rails_storage_proxy_path(@user.avatar.variant(:portrait)), class: "size-16 rounded-full object-cover bg-gray-100 ring-1 ring-gray-900/10"
        - else
          div class="flex size-16 items-center justify-center rounded-full bg-indigo-50 text-lg font-semibold text-indigo-700 ring-1 ring-gray-900/10"
            = @user.first_name.to_s.first.to_s.upcase + @user.last_name.to_s.first.to_s.upcase
      div class="pt-1"
        h1 class="text-2xl font-bold text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight"
          = @user.full_name
        p class="text-sm font-medium text-gray-500"
          = @user.email
        - if current_section.present?
          div class="mt-2 flex flex-wrap gap-2"
            - if @user.player_of?(current_section)
              span class="rounded-md bg-green-50 px-1.5 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20" Joueur
            - if @user.coach_of?(current_section)
              span class="rounded-md bg-indigo-50 px-1.5 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/20" Coach
    div class="mt-5 flex md:mt-0 md:ml-4"
      = link_to 'Voir le profil', profile_path, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 hover:bg-gray-50"

  / --- Profile form -------------------------------------------------------------
  = simple_form_for url_objects, html: {class: 'block'} do |f|
    = hidden_field_tag :return_to, @return_to

    div class="mt-8 overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5"
      div class="px-4 py-5 sm:p-6"
        h2 class="text-base font-semibold text-gray-900" Informations personnelles
        p class="mt-1 text-sm text-gray-600" Ces informations sont visibles par les autres membres de la section.

        div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2"
          = f.input :first_name, wrapper: :neutral_form, label: 'Prénom'
          = f.input :last_name, wrapper: :neutral_form, label: 'Nom'
          = f.input :nickname, wrapper: :neutral_form, label: 'Surnom'
          = f.input :phone_number, wrapper: :neutral_form, label: 'Téléphone'
          = f.input :email, wrapper: :neutral_form, label: 'Email', wrapper_html: {class: 'sm:col-span-2'}

        div class="mt-6 border-t border-gray-900/10 pt-6"
          = f.input :avatar, wrapper: :neutral_file, label: 'Photo de profil'

      - if current_section.present?
        div class="border-t border-gray-900/10 px-4 py-5 sm:p-6"
          h2 class="text-base font-semibold text-gray-900" Rôles dans la section
          p class="mt-1 text-sm text-gray-600" Un membre garde au moins un rôle dans la section.

          fieldset class="mt-6"
            legend class="sr-only" Rôles
            div class="space-y-4"
              div class="flex gap-3"
                div class="flex h-6 shrink-0 items-center"
                  = check_box_tag :player, 'player', @user.player_of?(current_section), class: 'size-4 rounded-sm border-gray-300 text-indigo-600 focus:ring-indigo-600'
                div class="text-sm/6"
                  = label_tag(:player, 'Joueur', class: 'font-medium text-gray-900')
                  p class="text-gray-500" Participe aux entraînements et peut être convoqué en match.
              div class="flex gap-3"
                div class="flex h-6 shrink-0 items-center"
                  = check_box_tag :coach, 'coach', @user.coach_of?(current_section), class: 'size-4 rounded-sm border-gray-300 text-indigo-600 focus:ring-indigo-600'
                div class="text-sm/6"
                  = label_tag(:coach, 'Coach', class: 'font-medium text-gray-900')
                  p class="text-gray-500" Gère les entraînements, les matchs et les membres de la section.

          - if @user.player_of?(current_section)
            - participation = @user.participations.find_by(section: current_section, season: Season.current, role: Participation::PLAYER)
            div class="mt-6"
              label for="main_position" class="block text-sm font-medium text-gray-900" Poste principal
              div class="mt-2 grid grid-cols-1 sm:max-w-xs"
                select id="main_position" name="main_position" class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-2 pr-8 pl-3 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
                  option value="" -- Aucun --
                  - Participation::POSITIONS.each do |pos|
                    option value=pos selected=(participation&.main_position == pos) = t("positions.#{pos}")
                svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-4 self-center justify-self-end text-gray-500"
                  path fill-rule="evenodd" clip-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"

      - if can_submit
        div class="flex items-center justify-end gap-x-4 border-t border-gray-900/10 bg-gray-50 px-4 py-4 sm:px-6"
          = link_to 'Annuler', profile_path, class: "text-sm font-semibold text-gray-900 hover:text-gray-700"
          = f.button :submit, 'Enregistrer', class: 'inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'

  / --- Relatives emails ---------------------------------------------------------
  div class="mt-8 overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5"
    div class="px-4 py-5 sm:p-6"
      h2 class="text-base font-semibold text-gray-900" Emails des proches
      p class="mt-1 text-sm text-gray-600"
        | Ces adresses sont en copie de tous les emails envoyés au joueur. Elles permettent à un parent de répondre aux convocations à sa place, sans compte séparé.

      - row_grid = 'grid grid-cols-[minmax(5rem,9rem)_1fr_7rem] items-center gap-x-4'
      - field_classes = 'block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600'

      div class="mt-6 border-t border-gray-100"
        div class="#{row_grid} border-b border-gray-100 py-2"
          div class="text-sm font-semibold text-gray-900" Lien
          div class="text-sm font-semibold text-gray-900" Email
          span class="sr-only" Actions

        - if @user.contact_emails.empty?
          p class="border-b border-gray-100 py-3 text-sm/6 text-gray-500" Aucun email de proche enregistré.

        - @user.contact_emails.each do |contact_email|
          div class="#{row_grid} border-b border-gray-100 py-3"
            div class="truncate text-sm/6 font-medium text-gray-900"= contact_email.label.presence || '—'
            div class="truncate text-sm/6 text-gray-500"= contact_email.email
            div class="flex justify-end"
              - contact_email_url = current_section ? section_user_contact_email_path(current_section, @user, contact_email) : user_contact_email_path(@user, contact_email)
              = button_to contact_email_url, method: :delete, form: {data: {turbo_confirm: "Supprimer #{contact_email.email} ?"}}, class: "rounded-md p-1.5 text-gray-400 hover:bg-red-50 hover:text-red-600"
                span class="sr-only" Supprimer
                svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"
                  path stroke-linecap="round" stroke-linejoin="round" d=trash_icon_path

        / legacy.css sets `form { display: inline }` app-wide, which beats Tailwind's layered
        / utilities, so the grid row goes on an inner div rather than on the form itself.
        = form_with url: contact_emails_url, scope: :user_contact_email, method: :post do |f|
          div class="#{row_grid} py-3"
            = f.text_field :label, placeholder: 'Maman, Papa…', class: field_classes, aria: {label: 'Lien'}
            = f.email_field :email, placeholder: 'parent@exemple.fr', required: true, class: field_classes, aria: {label: 'Email'}
            div class="flex justify-end"
              = f.submit 'Ajouter', class: 'inline-flex items-center justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500'

  / --- Absences -----------------------------------------------------------------
  - if current_section.present?
    div class="mt-8 overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5"
      div class="flex items-center justify-between gap-x-4 px-4 py-5 sm:px-6"
        div
          h2 class="text-base font-semibold text-gray-900"= t('views.counts.absence', count: @user.absences.size)
          p class="mt-1 text-sm text-gray-600" Périodes pendant lesquelles le membre est indisponible.
        = link_to 'Ajouter une absence', new_section_user_absence_path(current_section, @user), class: "shrink-0 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500"

      - if @user.absences.any?
        div class="overflow-x-auto border-t border-gray-900/10"
          table class="min-w-full divide-y divide-gray-200"
            thead class="bg-gray-50"
              tr
                th scope="col" class="py-3.5 pr-3 pl-4 text-left text-sm font-semibold text-gray-900 sm:pl-6" Période
                th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900" Motif
                th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900" Commentaire
                th scope="col" class="py-3.5 pr-4 pl-3 sm:pr-6"
                  span class="sr-only" Supprimer
            tbody class="divide-y divide-gray-100 bg-white"
              - @user.absences.each do |absence|
                tr
                  td class="py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap sm:pl-6"
                    = link_to edit_section_user_absence_path(current_section, @user, absence), class: "text-indigo-600 hover:text-indigo-900" do
                      = l(absence.start_at, format: '%-d %B %Y') if absence.start_at
                      = ' → '
                      = l(absence.end_at, format: '%-d %B %Y') if absence.end_at
                  td class="px-3 py-4 text-sm text-gray-500"= absence.name
                  td class="px-3 py-4 text-sm text-gray-500"= absence.comment
                  td class="py-4 pr-4 pl-3 text-right text-sm whitespace-nowrap sm:pr-6"
                    = button_to section_user_absence_path(current_section, @user, absence), method: :delete, form: {data: {turbo_confirm: 'Supprimer la absence ?'}}, class: "rounded-md p-1.5 text-gray-400 hover:bg-red-50 hover:text-red-600"
                      span class="sr-only" Supprimer
                      svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"
                        path stroke-linecap="round" stroke-linejoin="round" d=trash_icon_path
      - else
        div class="border-t border-gray-900/10 px-4 py-6 sm:px-6"
          p class="rounded-md border border-dashed border-gray-300 px-4 py-6 text-center text-sm text-gray-500" Aucune absence enregistrée.
