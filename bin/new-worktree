#!/usr/bin/env bash
#
# Create a git worktree with its own Postgres database, Redis DB index and web port,
# so several checkouts of martigua2 can run in parallel.
#
#   bin/new-worktree <name> [branch]
#
# The shared docker-compose stack (postgres_martigua2:54321, redis_martigua2:63791) is
# reused; isolation comes from the DB name and the Redis DB index. Each worktree gets a
# "slot" (1..7) recorded in its .env.local:
#
#   slot n -> db martigua2_<name>_{development,test}
#             redis db 2n (dev) / 2n+1 (test)
#             port 3000 + 10n
#
set -euo pipefail

PG_HOST="${POSTGRES_HOST:-localhost}"
PG_PORT="${POSTGRES_PORT:-54321}"
PG_USER="${POSTGRES_USER:-postgres}"
REDIS_HOST="${WORKTREE_REDIS_HOST:-localhost}"
REDIS_PORT="${WORKTREE_REDIS_PORT:-63791}"
MAX_SLOT=7

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[34m==>\033[0m %s\n' "$*"; }

[ $# -ge 1 ] || die "usage: bin/new-worktree <name> [branch]"

NAME="$1"
BRANCH="${2:-$1}"

# Always operate from the main checkout, whichever worktree we were invoked from.
MAIN_ROOT="$(dirname "$(git rev-parse --git-common-dir)")"
MAIN_ROOT="$(cd "$MAIN_ROOT" && pwd)"
[ -f "$MAIN_ROOT/config/database.yml" ] || die "not inside the martigua2 repository"

SLUG="$(printf '%s' "$NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/_/g; s/^_//; s/_$//')"
[ -n "$SLUG" ] || die "'$NAME' does not contain any usable character"

WT_PATH="$(dirname "$MAIN_ROOT")/$(basename "$MAIN_ROOT")-$SLUG"
[ -e "$WT_PATH" ] && die "$WT_PATH already exists"

DB_PREFIX="$(basename "$MAIN_ROOT" | tr '[:upper:]-' '[:lower:]_')_$SLUG"

# --- allocate the lowest free slot -------------------------------------------------
used_slots() {
  git -C "$MAIN_ROOT" worktree list --porcelain |
    sed -n 's/^worktree //p' |
    while read -r path; do
      [ -f "$path/.env.local" ] || continue
      sed -n "s/^WORKTREE_SLOT=['\"]\{0,1\}\([0-9]\{1,\}\).*/\1/p" "$path/.env.local"
    done
}

SLOT=""
USED="$(used_slots)"
for candidate in $(seq 1 "$MAX_SLOT"); do
  if ! printf '%s\n' "$USED" | grep -qx "$candidate"; then
    SLOT="$candidate"
    break
  fi
done
[ -n "$SLOT" ] || die "all $MAX_SLOT worktree slots are in use; free one with bin/rm-worktree"

REDIS_DEV_DB=$((SLOT * 2))
REDIS_TEST_DB=$((SLOT * 2 + 1))
PORT=$((3000 + SLOT * 10))
DEV_DB="${DB_PREFIX}_development"
TEST_DB="${DB_PREFIX}_test"

# --- create the worktree -----------------------------------------------------------
info "creating worktree $WT_PATH (slot $SLOT)"
if git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  git -C "$MAIN_ROOT" worktree add "$WT_PATH" "$BRANCH"
else
  git -C "$MAIN_ROOT" worktree add "$WT_PATH" -b "$BRANCH"
fi

# --- carry over the gitignored files a fresh checkout is missing --------------------
for f in .env.local .envrc config/master.key; do
  if [ -f "$MAIN_ROOT/$f" ]; then
    cp "$MAIN_ROOT/$f" "$WT_PATH/$f"
    info "copied $f"
  fi
done

# dotenv keeps the LAST definition found in a file, so appending overrides the copy.
cat >>"$WT_PATH/.env.local" <<EOF

# --- worktree: $SLUG (slot $SLOT) - generated by bin/new-worktree ---
WORKTREE_SLOT='$SLOT'
DB_NAME_PREFIX='$DB_PREFIX'
REDIS_URL='redis://$REDIS_HOST:$REDIS_PORT/$REDIS_DEV_DB'
PORT='$PORT'
EOF

# dotenv-rails deliberately skips .env.local in the test env, so tests need their own file.
cat >"$WT_PATH/.env.test.local" <<EOF
# --- worktree: $SLUG (slot $SLOT) - generated by bin/new-worktree ---
DB_NAME_PREFIX='$DB_PREFIX'
REDIS_URL='redis://$REDIS_HOST:$REDIS_PORT/$REDIS_TEST_DB'
EOF
info "wrote .env.local and .env.test.local"

# --- dependencies ------------------------------------------------------------------
info "installing gems"
(cd "$WT_PATH" && (bundle check >/dev/null 2>&1 || bundle install))

# --- development database ----------------------------------------------------------
info "creating database $DEV_DB"
createdb -h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" "$DEV_DB"

if [ -f "$MAIN_ROOT/latest.dump" ]; then
  info "restoring $MAIN_ROOT/latest.dump into $DEV_DB"
  # pg_restore exits non-zero on benign "does not exist" notices, hence the guard.
  pg_restore --no-acl --no-owner --clean --if-exists \
    -h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" -d "$DEV_DB" "$MAIN_ROOT/latest.dump" || true
  (cd "$WT_PATH" && bin/rails db:environment:set RAILS_ENV=development && bin/rails db:migrate)
  # db:migrate rewrites db/structure.sql from the restored dump, which differs from HEAD in
  # ways that have nothing to do with the branch. Keep the checkout clean.
  git -C "$WT_PATH" checkout -- db/structure.sql
else
  info "no latest.dump found, loading schema and seeds instead"
  (cd "$WT_PATH" && bin/rails db:prepare db:seed)
fi

# --- test database -----------------------------------------------------------------
info "preparing test database $TEST_DB"
(cd "$WT_PATH" && RAILS_ENV=test bin/rails db:create db:schema:load)

# --- summary -----------------------------------------------------------------------
cat <<EOF

$(printf '\033[32m✓\033[0m') worktree $SLUG (slot $SLOT)
  path   $WT_PATH
  branch $BRANCH
  db     $DEV_DB (test: $TEST_DB)
  redis  db $REDIS_DEV_DB (dev) / $REDIS_TEST_DB (test)
  url    http://localhost:$PORT

  cd $WT_PATH && bin/dev

EOF
